# Valeurs pour infra/compose/local.yml (identifiants de développement, sans valeur ailleurs).
# Chargé par `pnpm dev` ; un fichier .env à côté le surcharge, l'environnement réel reste prioritaire.
NODE_ENV=development
API_PORT=4000
# api et worker passent par PgBouncer (mode transaction).
DATABASE_URL=postgres://cotiz:cotiz@localhost:6432/cotiz
REDIS_URL=redis://localhost:6379
S3_ENDPOINT=http://localhost:9000

S3_ACCESS_KEY_ID=cotiz
S3_SECRET_ACCESS_KEY=cotiz-local-minio
CLAMAV_URL=tcp://127.0.0.1:3310
