{
  "name": "backend",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "dev": "concurrently --kill-others-on-fail -n api,worker -c blue,magenta \"node --run dev:api\" \"node --run dev:worker\"",
    "dev:api": "node --conditions=development --env-file=.env.example --env-file-if-exists=.env --import @swc-node/register/esm-register --import ./src/telemetry.ts --watch src/main.ts",
    "dev:worker": "node --conditions=development --env-file=.env.example --env-file-if-exists=.env --import @swc-node/register/esm-register --import ./src/telemetry.ts --watch src/worker.ts",
    "cli": "node --conditions=development --env-file=.env.example --env-file-if-exists=.env --import @swc-node/register/esm-register src/cli.ts",
    "start": "node --import ./dist/telemetry.js dist/main.js",
    "start:worker": "node --import ./dist/telemetry.js dist/worker.js",
    "lint": "eslint . && depcruise src --config .dependency-cruiser.cjs",
    "typecheck": "tsc --noEmit -p .",
    "test": "vitest run",
    "test:isolation": "vitest run test/isolation",
    "test:clamav": "vitest run --config vitest.clamav.config.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1149.0",
    "@aws-sdk/s3-request-presigner": "^3.1149.0",
    "@cotiz/contracts": "workspace:*",
    "@cotiz/db": "workspace:*",
    "@cotiz/domain": "workspace:*",
    "@nestjs/common": "^12.1.2",
    "@nestjs/core": "^12.1.2",
    "@nestjs/platform-express": "^12.1.2",
    "@node-rs/argon2": "^2.2.2",
    "@opentelemetry/api": "^1.9.1",
    "@opentelemetry/context-async-hooks": "^2.12.0",
    "@opentelemetry/core": "^2.12.0",
    "@opentelemetry/exporter-trace-otlp-http": "^0.223.0",
    "@opentelemetry/instrumentation": "^0.223.0",
    "@opentelemetry/instrumentation-express": "^0.71.0",
    "@opentelemetry/instrumentation-http": "^0.223.0",
    "@opentelemetry/instrumentation-ioredis": "^0.71.0",
    "@opentelemetry/instrumentation-pg": "^0.75.0",
    "@opentelemetry/resources": "^2.12.0",
    "@opentelemetry/sdk-trace-base": "^2.12.0",
    "@opentelemetry/sdk-trace-node": "^2.12.0",
    "@opentelemetry/semantic-conventions": "^1.43.0",
    "@sentry/node": "^11.6.0",
    "altcha-lib": "2.6.0",
    "bullmq": "^5.81.5",
    "drizzle-orm": "^0.45.4",
    "file-type": "^22.1.1",
    "ioredis": "^6.0.0",
    "jose": "^6.2.12",
    "pg": "^8.23.1",
    "pino": "^10.4.0",
    "prom-client": "^15.1.3",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "sharp": "^0.35.5",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@cotiz/config": "workspace:*",
    "@scalar/api-reference": "^1.72.3",
    "@swc-node/register": "^1.12.1",
    "@swc/core": "^1.16.13",
    "@testcontainers/postgresql": "^12.2.0",
    "@testcontainers/redis": "^12.2.0",
    "@types/node": "^22.20.4",
    "@types/pg": "^8.23.1",
    "concurrently": "^10.0.5",
    "dependency-cruiser": "^18.5.0",
    "pino-pretty": "^13.2.0",
    "testcontainers": "^12.2.0",
    "typescript": "^6.0.3",
    "unplugin-swc": "^2.0.0",
    "vitest": "^5.0.2"
  }
}
