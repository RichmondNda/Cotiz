{
  "name": "backend",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "concurrently --kill-others-on-fail -n api,worker -c blue,magenta \"node --run dev:api\" \"node --run dev:worker\"",
    "dev:api": "node --env-file-if-exists=.env --import @swc-node/register/esm-register --watch src/main.ts",
    "dev:worker": "node --env-file-if-exists=.env --import @swc-node/register/esm-register --watch src/worker.ts",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit -p ."
  },
  "dependencies": {
    "@nestjs/common": "^12.1.2",
    "@nestjs/core": "^12.1.2",
    "@nestjs/platform-express": "^12.1.2",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2"
  },
  "devDependencies": {
    "@cotiz/config": "workspace:*",
    "@swc-node/register": "^1.12.1",
    "@swc/core": "^1.16.13",
    "@types/node": "^22.20.4",
    "concurrently": "^10.0.5"
  }
}
