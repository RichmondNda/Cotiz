{
  "name": "cotiz",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.10.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "lint": "turbo run lint && eslint tools *.mjs && prettier --check .",
    "format": "prettier --write .",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "check:docs": "node tools/check-docs.mjs",
    "db:migrate": "pnpm --filter @cotiz/db migrate",
    "verify": "pnpm lint && pnpm typecheck && pnpm test && pnpm check:docs",
    "prepare": "husky"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.3",
    "@commitlint/config-conventional": "^21.2.3",
    "@cotiz/config": "workspace:*",
    "eslint": "^10.11.0",
    "husky": "^9.1.7",
    "lint-staged": "^17.6.0",
    "prettier": "^3.9.9",
    "turbo": "^2.11.5",
    "typescript": "^6.0.3",
    "yaml": "^2.9.1"
  },
  "lint-staged": {
    "{backend,packages,tools}/**/*.{ts,mts,js,mjs}": [
      "prettier --write",
      "eslint --no-warn-ignored --max-warnings=0"
    ],
    "{backend,packages,tools}/**/*.{json,yaml,yml}": [
      "prettier --write"
    ]
  },
  "pnpm": {
    "auditConfig": {
      "ignoreGhsas": [
        "GHSA-86w9-cpqp-85rv",
        "GHSA-vfj7-8cjw-p6xm",
        "GHSA-gcqx-w48m-w2h4"
      ]
    },
    "overrides": {
      "@nestjs/platform-express>multer": "^2.5.0"
    }
  }
}
