{
  "name": "@cotiz/contracts",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "development": "./src/index.ts",
      "default": "./dist/index.js"
    },
    "./openapi.json": "./openapi.json"
  },
  "scripts": {
    "gen": "node scripts/gen.mjs",
    "build": "tsc -p tsconfig.build.json",
    "lint": "eslint .",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "openapi": "tsc -p tsconfig.build.json && node scripts/openapi.mjs"
  },
  "devDependencies": {
    "@cotiz/config": "workspace:*",
    "@types/node": "^22.20.4",
    "prettier": "^3.9.9",
    "typescript": "^6.0.3",
    "vitest": "^5.0.2",
    "yaml": "^2.9.1"
  },
  "dependencies": {
    "zod": "^4.6.5",
    "zod-openapi": "^6.0.2"
  },
  "files": [
    "dist",
    "src",
    "openapi.json"
  ]
}
