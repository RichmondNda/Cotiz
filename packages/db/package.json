{
  "name": "@cotiz/db",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "development": "./src/index.ts",
      "default": "./dist/index.js"
    },
    "./migrate": {
      "types": "./src/migrate.ts",
      "development": "./src/migrate.ts",
      "default": "./dist/migrate.js"
    },
    "./rls": {
      "types": "./src/rls.ts",
      "development": "./src/rls.ts",
      "default": "./dist/rls.js"
    },
    "./testing": {
      "types": "./src/testing/index.ts",
      "development": "./src/testing/index.ts",
      "default": "./dist/testing/index.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "lint": "eslint .",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "migrate": "node --env-file-if-exists=../../backend/.env.example --env-file-if-exists=../../backend/.env src/migrate.ts",
    "rls": "node src/rls.ts"
  },
  "devDependencies": {
    "@cotiz/config": "workspace:*",
    "@testcontainers/postgresql": "^12.2.0",
    "@types/node": "^22.20.4",
    "@types/pg": "^8.23.1",
    "drizzle-kit": "^0.31.11",
    "testcontainers": "^12.2.0",
    "typescript": "^6.0.3",
    "vitest": "^5.0.3"
  },
  "dependencies": {
    "@cotiz/domain": "workspace:*",
    "drizzle-orm": "^0.45.4",
    "pg": "^8.23.1"
  },
  "files": [
    "dist",
    "src",
    "migrations"
  ]
}
